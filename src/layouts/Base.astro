---
import '../styles/global.css';
import { CONFIG } from '../lib/config';

interface Props {
  titulo: string;
  largo?: boolean;
  semNav?: boolean;
}
const { titulo, largo = false, semNav = false } = Astro.props;
const caminho = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const ativo = (href: string) => (href === '/' ? caminho === '/' || caminho === '/index' : caminho.startsWith(href));

const icones: Record<string, string> = {
  painel: '<path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z"/>',
  cronograma: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15l2 2 4-4"/>',
  lei: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/>',
  sessao: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  erros: '<path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
  questoes: '<circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>',
  redacao: '<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  simulados: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  edital: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  analise: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
  mais: '<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>',
  exportar: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
  tema: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  sair: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
};
const svg = (n: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icones[n]}</svg>`;

const principais = [
  { href: '/', nome: 'Painel', icone: 'painel' },
  { href: '/cronograma', nome: 'Cronograma', icone: 'cronograma' },
  { href: '/lei-seca', nome: 'Lei seca', icone: 'lei' },
  { href: '/sessao', nome: 'Sessão', icone: 'sessao' },
];
const secundarios = [
  { href: '/questoes', nome: 'Questões', icone: 'questoes' },
  { href: '/erros', nome: 'Caderno de erros', icone: 'erros' },
  ...(CONFIG.redacao.existe ? [{ href: '/redacao', nome: 'Redação', icone: 'redacao' }] : []),
  { href: '/simulados', nome: 'Simulados', icone: 'simulados' },
  { href: '/edital', nome: 'Edital', icone: 'edital' },
  { href: '/analise', nome: 'Análise', icone: 'analise' },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1f5fa8" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icone.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icone-192.png" />
    <title>{titulo} · {CONFIG.nome_site}</title>
    <script is:inline>
      try {
        var t = localStorage.getItem('caderno_tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {!semNav && (
      <script is:inline>
        try {
          if (!localStorage.getItem('caderno_usuario')) location.replace('/login?volta=' + encodeURIComponent(location.pathname + location.search + location.hash));
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <div class="app">
      {!semNav && (
        <nav class="nav" aria-label="Navegação principal">
          <span class="marca">{CONFIG.nome_site} <span id="nome-usuario" class="sutil pequeno"></span></span>
          {principais.map((i) => (
            <a href={i.href} aria-current={ativo(i.href) ? 'page' : undefined}><Fragment set:html={svg(i.icone)} />{i.nome}</a>
          ))}
          {secundarios.map((i) => (
            <a class="so-desktop" href={i.href} aria-current={ativo(i.href) ? 'page' : undefined}><Fragment set:html={svg(i.icone)} />{i.nome}</a>
          ))}
          <button class="so-desktop" type="button" data-acao="exportar"><Fragment set:html={svg('exportar')} />Exportar (.zip)</button>
          <button class="so-desktop" type="button" data-acao="tema"><Fragment set:html={svg('tema')} />Claro / escuro</button>
          <button class="so-desktop" type="button" data-acao="sair"><Fragment set:html={svg('sair')} />Sair</button>
          <span class="so-desktop status-sync" id="status-sync-d" style="padding: 8px 10px"></span>
          <button class="so-celular" type="button" id="btn-mais" aria-expanded="false"><Fragment set:html={svg('mais')} />Mais</button>
        </nav>
      )}
      {!semNav && (
        <div class="mais-menu" id="mais-menu">
          {secundarios.map((i) => <a href={i.href}>{i.nome}</a>)}
          <button type="button" data-acao="exportar">Exportar (.zip)</button>
          <button type="button" data-acao="tema">Claro / escuro</button>
          <button type="button" data-acao="sair">Sair <span class="sutil pequeno" id="nome-usuario-m"></span></button>
          <span class="status-sync" id="status-sync-m" style="padding: 8px 12px"></span>
        </div>
      )}
      <main class:list={['conteudo', { largo }]}>
        <slot />
      </main>
    </div>
    {!semNav && (
      <script>
        import { iniciarApp } from '../lib/app';
        iniciarApp();
      </script>
    )}
  </body>
</html>
